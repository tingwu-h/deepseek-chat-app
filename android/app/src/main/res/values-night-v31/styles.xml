        <item name="android:statusBarColor">@color/wanxiang_splash_background</item>
        <item name="android:navigationBarColor">@color/wanxiang_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/wanxiang_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/wanxiang_splash_android12</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
